{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/strict.json"],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    // NOTE: Schema.Number is the house style for numbers (see the language
    // service's schemaNumber, off for the same reason).
    "effecttsgo/schema-number": "off",
    // NOTE: FOLDKIT.md prescribes `Effect.catch(() => Effect.succeed(...))`
    // for a Command's fallback Message, and FOLDKIT.md wins.
    "effecttsgo/catch-to-or-else-succeed": "off",
    // NOTE: unstable APIs such as effect/unstable/sql are in use on purpose.
    "effecttsgo/unstable-api-usage": "off"
  }
}
